# One-off mutation scripts that used to sit in the repo root and rewrite
# source or ~/.botfleet at runtime.  Keep them out of git status so a
# later seat cannot run them by accident.
/patch*.py
/patch*.js
/patch*.cjs
/patch*.mjs
/fix-*.py
/fix_*.py
/trace*.py
/trace*.out
/test-time.js
# Throwaway PR-body draft the pr command used to leave at the repo root
# after a `gh pr create`.  The file is named with a leading dot but git
# tracks it once it exists — keep it out of the index in the first place.
.tmp-pr-body*
.tmp-pr-*.md
# Local-only debug scratch the Claude audit (`docs/audits/2026-09-24-efficiency-audit.md`,
# RH4) caught in the index: ad-hoc double-script files a seat drops at the
# repo root to repro something, never committed intentionally.
debug-cap.mjs
/debug-*.cjs
/debug-*.mjs
/debug-*.js
/test-auto*
/test-verdict*

# Editor / shell backup files (PR #218 inadvertently committed docs/EFFORT-LOG.md.bak)
*.bak
*.bak-*

# Python bytecode
__pycache__/
*.pyc

# Playwright run output: regenerated on every failing spec run, and it is
# never something to commit.  Without this, a `git add -A` after a local
# playwright run sweeps error-context.md and .last-run.json into the diff.
test-results/
playwright-report/

# The DSH/Clutch engine's own skill root for whatever checkout it runs in.
# Per AGENT-SYNC it outranks the shared `~/.agents/skills` and "no installer
# writes" it — the engine materializes it at runtime.  Left untracked-and-
# unignored it reads as local work, so the updater refused every run with
# "the always-on checkout has uncommitted changes" on a directory that was
# simply the engine doing its job.
# Exception: .agents/setup and .agents/resume are Amp orb lifecycle files
# (see https://ampcode.com/docs/orbs) and must stay tracked.
.agents/*
!.agents/setup
!.agents/resume

# Amp orb portal scratch (screenshots, preview links).  Never commit.
.amp/portals/

# Generated native server controller and Swift package products.
electron/resources/BotFleet Control.app/
mac-control/.build/
mac-control/.swiftpm/
# The fleet iOS version manifest publisher writes a local cache next to
# the script (scripts/ios-fleet/publish-ios-versions.sh).  It is a cache,
# not source:  keeping it out of git stops it from tripping the ship's
# dirty-worktree gate on the next local run.
scripts/ios-fleet/ios-app-versions.json
