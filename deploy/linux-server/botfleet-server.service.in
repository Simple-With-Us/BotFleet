[Unit]
Description=BotFleet harness server (headless, self-hosted on Linux)
Documentation=https://github.com/Simple-With-Us/BotFleet
After=network-online.target tailscaled.service
Wants=network-online.target
RequiresMountsFor=@BF_VOLUME@
ConditionPathIsMountPoint=@BF_VOLUME@

[Service]
Type=simple
User=@BF_USER@
Group=@BF_GROUP@
UMask=0007
WorkingDirectory=@BF_ROOT@/workdir
EnvironmentFile=@BF_ROOT@/config/server.env
Environment="HOME=@BF_ROOT@/home"
Environment="TMPDIR=@BF_ROOT@/tmp"
Environment="XDG_CONFIG_HOME=@BF_ROOT@/home/.config"
Environment="XDG_CACHE_HOME=@BF_ROOT@/home/.cache"
Environment="XDG_DATA_HOME=@BF_ROOT@/home/.local/share"
Environment="XDG_STATE_HOME=@BF_ROOT@/home/.local/state"
Environment="OMB_DATA_DIR=@BF_ROOT@/data"
Environment="OMB_STATIC_DIR=@BF_CODE@/dist"
Environment="OMB_PORT=8799"
Environment="npm_config_cache=@BF_ROOT@/home/.npm"
Environment="PATH=@BF_ROOT@/node/bin:@BF_ROOT@/home/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStartPre=@NODE_BIN@ @BF_ROOT@/bin/check-storage.mjs @BF_ROOT@/data
ExecStart=@BF_ROOT@/bin/start.sh @BF_ROOT@ @BF_CODE@ @NODE_BIN@
# Preflight diagnostics go to the journal; start.sh opens the append log
# only after checking storage inside this process's pinned namespace.
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=60

# The sandbox below makes every path read-only except the fleet volume.
# No privilege gain through setuid binaries.
NoNewPrivileges=yes
# The whole filesystem is read-only.
ProtectSystem=strict
# /home and /root stay read-only.
ProtectHome=read-only
# The fleet volume is the only writable path.
ReadWritePaths=@BF_VOLUME@
# Pin the dedicated volume in this unit's namespace, including across host
# unmounts; stopping the unit releases it and permits maintenance unmounts.
BindPaths=@BF_VOLUME@
MountFlags=private
# Tool paths that ignore TMPDIR still write to the volume, not root disk.
PrivateTmp=no
BindPaths=@BF_ROOT@/tmp:/tmp @BF_ROOT@/var-tmp:/var/tmp
# Kernel tunables stay read-only.
ProtectKernelTunables=yes
# The cgroup file system stays read-only.
ProtectControlGroups=yes
# No new suid or sgid files.
RestrictSUIDSGID=yes
# The memory layout cannot be changed.
LockPersonality=yes

[Install]
WantedBy=multi-user.target
