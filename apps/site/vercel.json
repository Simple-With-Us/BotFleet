{
  "git": {"deploymentEnabled": {"**": false, "main": true}},
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "bash vercel-ignore-hourly.sh",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
