+  native-host-draft:
+    name: Attach the native host artifact to the draft release
+    # `!cancelled()` is what lets this job be evaluated at all after a skipped
+    # draft job or host job.  It then runs only when the run asked for a draft
+    # that is not the unverified one, and only after BOTH the host job verified
+    # its artifact and the app's draft job succeeded:  a failed or skipped host
+    # job attaches nothing, and nothing is ever added to a release the app's
+    # own job did not prepare.
+    if: ${{ !cancelled() && inputs.native-host && inputs.draft && !inputs.unsigned-draft && needs.mac-native-host.result == 'success' && needs.draft.result == 'success' }}
+    needs: [prepare, mac-native-host, draft]
+    runs-on: ubuntu-26.04
+    timeout-minutes: 10
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.prepare.outputs.sha }}
+          persist-credentials: false
+      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
+        with:
+          name: native-mac-host-release
+          path: host-assets
+      # This runner cannot mount the image or read a macOS signature.  What it
+      # can prove is that these bytes are the bytes the macOS job verified:  the
+      # receipt still names the pinned commit and build, the image hashes to the
+      # digest the receipt names, and that digest is the one the verifying step
+      # reported.
+      - name: Verify the downloaded bytes are the ones the macOS job verified
+        env:
+          SOURCE_COMMIT: ${{ needs.prepare.outputs.sha }}
+          BUILD: ${{ needs.prepare.outputs.build }}
+          ARTIFACT_SHA256: ${{ needs.mac-native-host.outputs.artifact_sha256 }}
+        run: |
+          node scripts/verify-native-host-artifact.mjs release host-assets \
+            --source "$SOURCE_COMMIT" --build "$BUILD" \
+            --expect-artifact-sha256 "$ARTIFACT_SHA256" --no-mount
+      - name: Attach the native host artifact to the draft
+        env:
+          GH_TOKEN: ${{ github.token }}
+          VERSION: ${{ needs.prepare.outputs.version }}
+          BUILD: ${{ needs.prepare.outputs.build }}
+          ARTIFACT: ${{ needs.mac-native-host.outputs.artifact }}
+        run: |
+          set -euo pipefail
+          cd host-assets
+          tag="v${VERSION}-${BUILD}${NATIVE_TAG_SUFFIX}"
+          # The draft guard is repeated here because the release can be
+          # published by hand between the app's attach job and this one.
+          if ! existing="$(gh api "repos/$RELEASES_REPO/releases/tags/$tag" 2>/dev/null)"; then
+            echo "::error::$tag does not exist on $RELEASES_REPO; the app's draft job creates it and this job only adds to it"
+            exit 1
+          fi
+          [ "$(jq -r .draft <<< "$existing")" = true ] || {
+            echo "::error::$tag is no longer a draft; refusing to add the native host artifact to it"; exit 1; }
+          # The BotFleetNativeHost- prefix cannot collide with the app's assets,
+          # so --clobber here can only replace this job's own earlier upload.
+          gh release upload "$tag" "$ARTIFACT" --repo "$RELEASES_REPO" --clobber
+          echo "native host artifact on $tag: $(gh release view "$tag" --repo "$RELEASES_REPO" --json assets --jq '[.assets[].name] | join(", ")')"
