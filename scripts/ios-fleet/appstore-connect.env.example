# Optional override for a one-off run:  export these three in the environment.
# On Jay's Mac the ship scripts read Infisical Fleet-OPS through fleet-secrets
# (/appstore-connect ASC_KEY_ID and ASC_ISSUER_ID, the .p8 in
# /authkey-<key id lowercase>-p8 AUTHKEY_<KEY_ID>) and nothing is read from
# ~/.secrets.  Never commit real values.
#
# Create key: App Store Connect -> Users and Access -> Integrations -> App Store Connect API
# Role: Admin or App Manager. Download the .p8 once.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Optional Apple ID path (only if not using API key):
# APPLE_ID=you@example.com
# APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
